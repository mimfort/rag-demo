# Скопируй этот файл в .env и при необходимости поправь значения.
# .env подхватывает python-dotenv в rag/config.py.

# --- LM Studio (где крутятся модели) ---
# Адрес LM Studio. v1 в конце — это OpenAI-совместимый префикс API,
# который LM Studio выставляет наружу.
# Локально обычно http://localhost:1234/v1. Если LM Studio на другой
# машине в LAN — подставь её IP.
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Токен авторизации LM Studio. У OpenAI-совместимого API ключ
# передаётся в заголовке Authorization: Bearer <TOKEN>.
# Сгенерируй свой в LM Studio: Settings → Developer → API key.
LM_STUDIO_API_KEY=your-lm-studio-api-key-here

# Имя embedding-модели. Должно совпадать с тем, как модель называется в LM Studio.
# Точный список можно получить запросом: GET {LM_STUDIO_BASE_URL}/models
EMBEDDING_MODEL=text-embedding-bge-m3

# Размерность векторов у выбранной модели. У bge-m3 это 1024.
# Должно совпадать с числом в db/init.sql -> vector(1024).
EMBEDDING_DIM=1024

# Имя chat-модели для генерации ответа.
# Замени на то имя, под которым модель видна в LM Studio (вкладка My Models).
CHAT_MODEL=google/gemma-3-4b-it

# --- PostgreSQL ---
# Параметры подключения к контейнеру postgres из docker-compose.yml.
# Если запускаешь скрипты с хоста (а не из контейнера) — host=localhost.
DB_HOST=localhost
# 5433 чтобы не конфликтовать с системным Postgres, если он занимает 5432.
DB_PORT=5433
DB_NAME=rag
DB_USER=rag
DB_PASSWORD=rag

# --- Параметры RAG ---
# Размер чанка (в символах) при нарезке документа.
# Чем больше — тем больше контекста в одном фрагменте, но тем «размытее»
# его эмбеддинг. Для bge-m3 на русском 400-700 символов — разумный диапазон.
CHUNK_SIZE=500

# Перекрытие соседних чанков. Нужно чтобы фраза, попавшая на стык,
# не «потерялась». Обычно берут 10-20% от CHUNK_SIZE.
CHUNK_OVERLAP=80

# Сколько ближайших чанков подкладывать в промпт LLM.
TOP_K=5

# --- Agent (Spec 1: skkrondo concierge) ---
SKKRONDO_BASE_URL=https://api.skkrondo.ru
