# Скопируй этот файл в .env и при необходимости поправь значения.
# .env подхватывает python-dotenv в rag/config.py.

# --- LLM (chat) — OpenAI-совместимый провайдер ---
# По умолчанию OpenRouter. Для другого оператора поменяй base_url/ключ/модель.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Токен OpenRouter (Settings → Keys), передаётся как Authorization: Bearer <ключ>.
LLM_API_KEY=your-openrouter-api-key-here
# Идентификатор модели у оператора, напр. anthropic/claude-3.5-sonnet или openai/gpt-4o.
LLM_MODEL=
# Опциональные заголовки атрибуции OpenRouter (можно оставить пустыми).
LLM_HTTP_REFERER=
LLM_APP_TITLE=

# --- Voyage AI (embeddings + rerank) ---
VOYAGE_API_KEY=your-voyage-api-key-here
VOYAGE_BASE_URL=https://api.voyageai.com/v1
# Embedding-модель. voyage-4-large по умолчанию даёт 1024 измерения.
VOYAGE_EMBEDDING_MODEL=voyage-4-large
# Reranker-модель.
VOYAGE_RERANK_MODEL=rerank-2.5
# Размерность векторов. Должна совпадать с vector(1024) в db/init.sql.
EMBEDDING_DIM=1024

# --- PostgreSQL ---
# Параметры подключения к контейнеру postgres из docker-compose.yml.
# Если запускаешь скрипты с хоста (а не из контейнера) — host=localhost.
DB_HOST=localhost
# 5433 чтобы не конфликтовать с системным Postgres, если он занимает 5432.
DB_PORT=5433
DB_NAME=rag
DB_USER=rag
DB_PASSWORD=rag

# --- Параметры RAG ---
# Размер чанка (в символах) при нарезке документа.
# Чем больше — тем больше контекста в одном фрагменте, но тем «размытее»
# его эмбеддинг. Для bge-m3 на русском 400-700 символов — разумный диапазон.
CHUNK_SIZE=500

# Перекрытие соседних чанков. Нужно чтобы фраза, попавшая на стык,
# не «потерялась». Обычно берут 10-20% от CHUNK_SIZE.
CHUNK_OVERLAP=80

# Сколько ближайших чанков подкладывать в промпт LLM.
TOP_K=5

# --- Agent (Spec 1: skkrondo concierge) ---
SKKRONDO_BASE_URL=https://api.skkrondo.ru
